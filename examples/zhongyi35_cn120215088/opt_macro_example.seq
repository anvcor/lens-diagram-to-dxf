! CN120215088 Ex2  Zhongyi 34mm F1.45  -- optimization macro
! Run after the lens is loaded (IN CN120215088_Ex02_Zhongyi34mmF145.seq).
! Spheres: radius kept within +-5% of the start value (RDY).
! Aspheres S16 S17 S27 S28: vertex R kept in |R| 30..500 (same sign, machining limit).
! Variables are NOT set by this macro -- set them in the lens before running.

AUT

EFL Z1 > 33.8
EFL Z1 < 35

! distortion at full field (fraction), patent fig.4: INF +0.64%
DIY F10 Z1 < 0.009
DIY F10 Z1 > 0.002

! ---- asphere vertex radius: same sign as patent, |R| 30..500 ----
RDY S16 > 30
RDY S16 < 500
RDY S17 < -30
RDY S17 > -500
RDY S27 < -30
RDY S27 > -500
RDY S28 < -30
RDY S28 > -500

! ---- sphere radius, +-5% of start value ----
RDY S1 < 66.6573
RDY S1 > 60.3089
RDY S2 < 28.5639
RDY S2 > 25.8435
RDY S3 < 45.7099
RDY S3 > 41.3565
RDY S5 < 606.2192
RDY S5 > 548.4840
RDY S6 < 20.8059
RDY S6 > 18.8243
RDY S7 < -39.2343
RDY S7 > -43.3643
RDY S8 < -81.3950
RDY S8 > -89.9628
RDY S9 < 64.1806
RDY S9 > 58.0682
RDY S10 < -58.0682
RDY S10 > -64.1806
RDY S11 < -54.5107
RDY S11 > -60.2487
RDY S12 < 21.9399
RDY S12 > 19.8503
RDY S13 < -23.2381
RDY S13 > -25.6843
RDY S14 < -67.6119
RDY S14 > -74.7289
RDY S19 < 30.6431
RDY S19 > 27.7247
RDY S20 < 40.3606
RDY S20 > 36.5168
RDY S21 < -18.8243
RDY S21 > -20.8059
RDY S22 < -67.6119
RDY S22 > -74.7289
RDY S23 < 64.1806
RDY S23 > 58.0682
RDY S24 < -58.0682
RDY S24 > -64.1806
RDY S25 < -69.1271
RDY S25 > -76.4037
RDY S26 < 30.6431
RDY S26 > 27.7247

THI S30 > 0.3

ET S12 > 2.2
ET S26 > 0.2

INT NO
MXC 30
MNC 30
!EFT WFR
EFT TA
DRA S1..I YES

EFP ALL Y
MNT 0.8
MNE 1.5
MNA 0.05

GLA S1..I HFK95N HLAK53B TAFD30L TAFD55W HZF52

GO
